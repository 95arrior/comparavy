# ─── Anthropic (글 생성 엔진) ───────────────────────────────
ANTHROPIC_API_KEY=
# 사용 모델 (기본값: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Supabase (인증 · DB) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ─── 토스페이먼츠 빌링 (자동결제) ───────────────────────────
# 테스트 키로 개발 가능. 클라이언트 키만 NEXT_PUBLIC_ 허용.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 시크릿 키 — 서버 전용, 절대 NEXT_PUBLIC_ 금지
TOSS_SECRET_KEY=

# 정기 청구 cron 보호용 시크릿 (임의의 긴 랜덤 문자열)
BILLING_CRON_SECRET=

# ─── 사이트 ─────────────────────────────────────────────────
# 배포 도메인 (예: https://ateflo.com). OAuth 리다이렉트 등에 사용.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 구글 서치콘솔 연동 (5-1) ───────────────────────────────
# 로그인용(Supabase)과 별개의 자체 OAuth 2.0 클라이언트. Search Console API 활성화 필요.
# 스코프 webmasters.readonly(민감) → 프로덕션 공개 전 구글 검증, 그 전엔 테스트 사용자만.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 선택: 콜백 URL을 직접 지정(미설정 시 {origin}/api/searchconsole/callback 사용)
GSC_REDIRECT_URI=
# 토큰 암호화 키(WP 연동과 공유). 32바이트 이상 랜덤. 미설정 시 토큰이 평문 저장됨.
WP_ENCRYPTION_KEY=
